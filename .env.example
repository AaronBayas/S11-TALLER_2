# Copiar este archivo como .env y completar los valores locales.
# El archivo .env NO se entrega ni se sube a ningún repositorio.

PORT=3000

# Conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taller_api
DB_USER=
DB_PASSWORD=

# Secreto para firmar los JWT (cadena larga y aleatoria)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Cuenta de prueba que crea "npm run db:init" (la contraseña se guarda con hash bcrypt)
TEST_USER=admin
TEST_PASSWORD=
